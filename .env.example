# Server Configuration
PORT=3000
HOST=0.0.0.0
API_KEY=wa_secret_token_12345

# Bot Configuration
BOT_NAME=Alexa
PREFIX=!
# Comma-separated owner phone numbers (e.g. 628123456789,628987654321)
OWNER_NUMBERS=
# Optional footer text appended to responses (leave empty for none)
FOOTER_TEXT=

# AI Engine Configuration
# Supported providers: gemini | openai | groq | deepseek | ollama | custom
AI_PROVIDER=gemini
# API Key for chosen provider (leave empty for local Ollama)
AI_API_KEY=
# Model name (e.g. gemini-1.5-flash, gpt-4o-mini, openai/gpt-oss-120b, openai/gpt-oss-20b, deepseek-chat)
AI_MODEL=gemini-1.5-flash
# Custom Base URL (required for Ollama e.g. http://localhost:11434/v1 or custom reverse proxy)
AI_BASE_URL=
# System prompt / business context
AI_SYSTEM_PROMPT=You are a helpful and polite assistant for our business. Keep responses concise and clear.
# Automatically reply to non-command private messages using AI
AI_AUTO_REPLY=false
# Maximum number of chat history messages to preserve per session (sliding window)
AI_MAX_HISTORY=6
# Session inactivity timeout in minutes before memory is evicted
AI_SESSION_TIMEOUT_MIN=15

# Webhook Forwarding
# URL to forward inbound messages to (leave empty to disable)
WEBHOOK_URL=
# Optional secret token sent in x-webhook-secret header
WEBHOOK_SECRET=

# WhatsApp Connection
SESSION_NAME=alexa_session
# Set to 'true' to use 8-digit pairing code instead of QR code
USE_PAIRING_CODE=false
# If USE_PAIRING_CODE is true, specify phone number (e.g. 628123456789)
PAIRING_PHONE_NUMBER=

# Anti-Ban / Throttling
# Minimum delay (in ms) between outgoing automated messages
MESSAGE_DELAY_MS=2500
