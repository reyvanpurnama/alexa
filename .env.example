# Server Configuration
PORT=3000
HOST=0.0.0.0
API_KEY=wa_secret_token_12345

# Bot Configuration
BOT_NAME=Alexa
PREFIX=!
# Comma-separated owner phone numbers (e.g. 628123456789,628987654321)
OWNER_NUMBERS=
# Optional footer text appended to responses (leave empty for none)
FOOTER_TEXT=

# Webhook Forwarding
# URL to forward inbound messages to (leave empty to disable)
WEBHOOK_URL=
# Optional secret token sent in x-webhook-secret header
WEBHOOK_SECRET=

# WhatsApp Connection
SESSION_NAME=alexa_session
# Set to 'true' to use 8-digit pairing code instead of QR code
USE_PAIRING_CODE=false
# If USE_PAIRING_CODE is true, specify phone number (e.g. 628123456789)
PAIRING_PHONE_NUMBER=

# Anti-Ban / Throttling
# Minimum delay (in ms) between outgoing automated messages
MESSAGE_DELAY_MS=2500
