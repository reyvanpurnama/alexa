# ==========================================
# ⚙️ SERVER CONFIGURATION
# ==========================================
PORT=3000
HOST=0.0.0.0
API_KEY=wa_secret_token_12345

# ==========================================
# 🤖 BOT IDENTITY & BEHAVIOR
# ==========================================
BOT_NAME=Alexa
PREFIX=!
# Comma-separated owner phone numbers (e.g. 628123456789,628987654321)
OWNER_NUMBERS=
# Optional footer text appended to system responses
FOOTER_TEXT=⚡ Powered by Alexa

# ==========================================
# 📱 WHATSAPP CONNECTION
# ==========================================
SESSION_NAME=alexa_session
# Set to 'true' if you want 8-digit pairing code instead of QR code
USE_PAIRING_CODE=false
# If USE_PAIRING_CODE is true, enter phone number here (e.g. 628123456789)
PAIRING_PHONE_NUMBER=

# ==========================================
# 🛡️ ANTI-BAN & SAFETY SETTINGS
# ==========================================
# Minimum delay (in ms) between outgoing automated messages
MESSAGE_DELAY_MS=2500
